<ui:FluentWindow x:Class="DogeHyperSecurity.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:views="clr-namespace:DogeHyperSecurity.Views"
                 Title=""
                 Width="860" Height="424"
                 ResizeMode="NoResize"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="None"
                 WindowCornerPreference="Round"
                 Background="#FFFFFF"
                 FontFamily="Microsoft YaHei UI, Segoe UI"
                 TextOptions.TextFormattingMode="Display">

    <ui:FluentWindow.Resources>
        <Style x:Key="NavItemButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}">
                            <Grid>
                                <Rectangle x:Name="Ind" Width="3" Height="15" Fill="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Left" Margin="4,0,0,0" Visibility="Collapsed" />
                                <ContentPresenter Margin="14,0,6,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EDEDED" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter TargetName="Bd" Property="Background" Value="#F4F4F4" />
                                <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogCloseButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <ui:TitleBar Title=""
                         ShowMinimize="True" ShowMaximize="False" ShowClose="True" ShowHelp="False" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="88" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="#EDEDED" Panel.ZIndex="5" />

            <!-- 左侧导航 -->
            <Border Grid.Column="0" Background="#F7F7F7" BorderBrush="#EDEDED" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,17,0,0">
                    <Button x:Name="NavWelcome" Style="{StaticResource NavItemButton}" Tag="Selected"
                            Click="NavWelcome_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Foreground="#4B4B4B" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="欢迎" FontSize="13.5" Foreground="#2B2B2B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRegister" Style="{StaticResource NavItemButton}" Click="NavRegister_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="PersonAdd24" FontSize="16" Foreground="#4B4B4B" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="注册" FontSize="13.5" Foreground="#2B2B2B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavRecharge" Style="{StaticResource NavItemButton}" Click="NavRecharge_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Wallet24" FontSize="16" Foreground="#4B4B4B" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="充值" FontSize="13.5" Foreground="#2B2B2B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="NavChangePassword" Style="{StaticResource NavItemButton}" Click="NavChangePassword_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Password24" FontSize="16" Foreground="#4B4B4B" Margin="0,0,10,0"
                                           VerticalAlignment="Center" />
                            <TextBlock Text="改密" FontSize="13.5" Foreground="#2B2B2B" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Margin="4,0,4,10">
                        <TextBlock Text="账号登录" FontSize="11.5" Foreground="#4B4B4B" HorizontalAlignment="Center" />
                        <ui:ToggleSwitch x:Name="AccountLoginSwitch" HorizontalAlignment="Center" Margin="0,2,0,0" />
                        <TextBlock Text="卡密登录" FontSize="11.5" Foreground="#4B4B4B" HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />
                        <ui:ToggleSwitch x:Name="CardLoginSwitch" HorizontalAlignment="Center" Margin="0,2,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 内容区 -->
            <Grid Grid.Column="1" Background="#FFFFFF">
                <views:WelcomeView x:Name="WelcomePageView" />
                <views:RegisterView x:Name="RegisterPageView" Visibility="Collapsed"
                                    Cancelled="Form_Cancelled" />
                <views:RechargeView x:Name="RechargePageView" Visibility="Collapsed"
                                    Cancelled="Form_Cancelled" />
                <views:ChangePasswordView x:Name="ChangePasswordPageView" Visibility="Collapsed"
                                          Cancelled="Form_Cancelled" />
            </Grid>

            <!-- 弹窗层 -->
            <Grid x:Name="DialogLayer" Grid.ColumnSpan="2" Panel.ZIndex="20" Background="Transparent"
                  Visibility="Collapsed">

                <Border x:Name="WarningDialog" Width="382" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4"
                        MouseLeftButtonDown="Dialog_MouseLeftButtonDown"
                        MouseMove="Dialog_MouseMove" MouseLeftButtonUp="Dialog_MouseLeftButtonUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,12,8,0">
                            <TextBlock Text="警告" FontSize="14" FontWeight="Bold" Foreground="#1F1F1F" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right"
                                    Click="WarningClose_Click">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#333333" />
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="14,26,14,0" FontSize="13" FontWeight="Bold" Foreground="#333333"
                                   TextWrapping="Wrap" LineHeight="20"
                                   Text="测试" />

                        <Grid Grid.Row="2" Margin="14,12,14,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0" Height="32" Content="确定" Appearance="Primary" FontSize="13"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Click="WarningConfirm_Click" />
                            <ui:Button Grid.Column="2" Height="32" Content="取消" Appearance="Light" FontSize="13"
                                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                       Click="WarningCancel_Click" />
                        </Grid>
                    </Grid>
                </Border>

                <Border x:Name="NoticeDialog" Width="445" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="White" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="4"
                        Visibility="Collapsed" MouseLeftButtonDown="Dialog_MouseLeftButtonDown"
                        MouseMove="Dialog_MouseMove" MouseLeftButtonUp="Dialog_MouseLeftButtonUp">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#000000" />
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="14,4,8,0">
                            <TextBlock Text="!!注意!!" FontSize="14" FontWeight="Bold" Foreground="#1F1F1F" VerticalAlignment="Center" />
                            <Button Style="{StaticResource DialogCloseButton}" HorizontalAlignment="Right"
                                    Click="NoticeClose_Click">
                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" Foreground="#333333" />
                            </Button>
                        </Grid>

                        <TextBlock Grid.Row="1" Margin="14,14,14,0" FontSize="13" FontWeight="Bold" Foreground="#333333" TextWrapping="Wrap"
                                   LineHeight="22"
                                   Text="测试" />

                        <ui:Button Grid.Row="2" Margin="14,12,14,14" Height="32" Content="关闭" Appearance="Light" FontSize="13"
                                   HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                   Click="NoticeClose_Click" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
