<UserControl x:Class="DogeHyperSecurity.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="帐号注册" FontSize="18" FontWeight="Bold" Foreground="#1F1F1F" />

        <Grid Grid.Row="1" Margin="0,24,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="账号:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,16" />
            <Border Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,16" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RegAccountBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="密码:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,16" />
            <Border Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,0,16" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RegPasswordBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="超级密码:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,16" />
            <Border Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,0,16" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RegSuperPasswordBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="充值卡密:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Border Grid.Row="3" Grid.Column="1" Height="30" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RegCardKeyBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>
        </Grid>

        <TextBlock x:Name="RegStatus" Grid.Row="2" VerticalAlignment="Bottom" Margin="0,8,0,0"
                   FontSize="12.5" TextWrapping="Wrap" Foreground="#C42B1C" Visibility="Collapsed" />

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="RegisterButton" Grid.Column="0" Height="32" Content="注册" Appearance="Primary" FontSize="13"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Register_Click" />
            <ui:Button Grid.Column="2" Height="32" Content="取消" Appearance="Light" FontSize="13"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </Grid>
    </Grid>
</UserControl>
