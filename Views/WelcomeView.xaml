<UserControl x:Class="DogeHyperSecurity.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             TextOptions.TextFormattingMode="Display">
    <UserControl.Resources>
        <Style x:Key="LoginTabButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="44" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#6B6B6B" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Rectangle x:Name="Ind" Width="64" Height="2" Fill="{StaticResource AccentBrush}"
                                       VerticalAlignment="Bottom" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#3A3A3A" />
                            </Trigger>
                            <Trigger Property="Tag" Value="Selected">
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Ind" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12,12,12,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="342" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 公告 -->
        <Border Grid.Column="0" Style="{StaticResource CardBorder}" VerticalAlignment="Top" MinHeight="340">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <ui:SymbolIcon Symbol="Megaphone24" FontSize="20" Foreground="#0F6CBD" Margin="0,0,8,0"
                                   VerticalAlignment="Center" />
                    <TextBlock Text="公告" FontSize="17" FontWeight="Bold" Foreground="#1F1F1F"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ScrollViewer Margin="16,16,16,12" MaxHeight="270" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="AnnouncementText" Text="正在获取公告…" FontSize="15" FontWeight="Bold"
                               Foreground="#333333" TextWrapping="Wrap" LineHeight="22" />
                </ScrollViewer>
            </StackPanel>
        </Border>

        <!-- 登录 -->
        <Border Grid.Column="2" Style="{StaticResource CardBorder}" VerticalAlignment="Top" MinHeight="340">
            <StackPanel>
                <Grid Margin="0,-4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="AccountTab" Style="{StaticResource LoginTabButton}"
                            Content="帐号登录" Click="AccountTab_Click" />
                    <Button x:Name="CardTab" Grid.Column="1" Style="{StaticResource LoginTabButton}" Tag="Selected"
                            Content="卡密登录" Click="CardTab_Click" />
                </Grid>
                <Border Height="1" Background="#E5E5E5" Margin="0,-1,0,0" />

                <!-- 帐号登录 -->
                <StackPanel x:Name="AccountPanel" Margin="0,10,0,0" Visibility="Collapsed">
                    <TextBlock Text="帐号:" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource InputBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Person24" FontSize="14" Foreground="#8A8A8A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="AccountBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                     FontSize="13.5"
                                     GotFocus="AccountBox_GotFocus" LostFocus="AccountBox_LostFocus" />
                            <Rectangle x:Name="AccountUnderline" Grid.ColumnSpan="2" Height="2"
                                       Fill="{StaticResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <TextBlock Text="密码:" Style="{StaticResource SectionLabel}" Margin="0,8,0,4" />
                    <Border Style="{StaticResource InputBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="34" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PasswordIcon" Grid.Column="0" Symbol="LockClosed24" FontSize="14"
                                           Foreground="#8A8A8A" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <PasswordBox x:Name="PasswordInput" Grid.Column="1" Style="{StaticResource FlatPasswordBox}"
                                         PasswordChar="*" FontSize="13.5"
                                         GotFocus="Password_GotFocus" LostFocus="Password_LostFocus" />
                            <TextBox x:Name="PlainPassword" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                     Visibility="Collapsed" FontSize="13.5"
                                     GotFocus="Password_GotFocus" LostFocus="Password_LostFocus" />
                            <ui:Button x:Name="TogglePasswordButton" Grid.Column="2" Appearance="Transparent"
                                       Width="32" Height="32" Padding="0" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Click="TogglePassword_Click">
                                <ui:SymbolIcon x:Name="EyeIcon" Symbol="Eye24" FontSize="14" Foreground="#8A8A8A" />
                            </ui:Button>
                            <Rectangle x:Name="PasswordUnderline" Grid.ColumnSpan="3" Height="2"
                                       Fill="{StaticResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="AutoLoginCheck" Content="自动登录" FontSize="13" />
                        <CheckBox x:Name="RememberAccountCheck" Content="记住账号密码" FontSize="13"
                                  Margin="18,0,0,0" />
                    </StackPanel>

                    <ui:Button x:Name="AccountLoginButton" Height="38" Margin="0,12,0,0" Content="登录"
                               Appearance="Primary" Icon="{ui:SymbolIcon Key24}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Focusable="False" Click="Login_Click" />
                    <TextBlock x:Name="AccountStatus" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="#C42B1C" Visibility="Collapsed" />
                </StackPanel>

                <!-- 卡密登录 -->
                <StackPanel x:Name="CardPanel" Margin="0,10,0,0">
                    <TextBlock Text="卡密:" Style="{StaticResource SectionLabel}" Margin="0,0,0,4" />
                    <Border Style="{StaticResource InputBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Key24" FontSize="14" Foreground="#8A8A8A"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="CardKeyBox" Grid.Column="1" Style="{StaticResource FlatTextBox}"
                                     FontSize="13.5" GotFocus="CardKeyBox_GotFocus"
                                     LostFocus="CardKeyBox_LostFocus" />
                            <Rectangle x:Name="CardKeyUnderline" Grid.ColumnSpan="2" Height="2"
                                       Fill="{StaticResource AccentBrush}" RadiusX="1" RadiusY="1"
                                       VerticalAlignment="Bottom" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <ui:Button x:Name="CardLoginButton" Height="38" Margin="0,12,0,0" Content="登录"
                               Appearance="Primary" Icon="{ui:SymbolIcon Key24}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Center" Focusable="False" Click="Login_Click" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <CheckBox x:Name="CardAutoLoginCheck" Content="自动登录" FontSize="13" />
                        <CheckBox x:Name="RememberCardCheck" Content="记住卡密" FontSize="13"
                                  Margin="18,0,0,0" />
                    </StackPanel>
                    <TextBlock x:Name="CardStatus" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                               Foreground="#C42B1C" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
