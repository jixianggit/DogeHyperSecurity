<UserControl x:Class="DogeHyperSecurity.Views.RechargeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             FontFamily="Microsoft YaHei UI, Segoe UI"
             TextOptions.TextFormattingMode="Display">
    <Grid Margin="16,14,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="充值" FontSize="18" FontWeight="Bold" Foreground="#1F1F1F" />

        <Grid Grid.Row="1" Margin="0,24,0,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="90" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="账号:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,16" />
            <Border Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,0,16" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RcAccountBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="充值卡密:" FontSize="13" Foreground="#333333"
                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0" />
            <Border Grid.Row="1" Grid.Column="1" Height="30" Background="White"
                    BorderBrush="#D6D6D6" BorderThickness="1" CornerRadius="2">
                <TextBox x:Name="RcCardKeyBox" Style="{StaticResource FlatTextBox}" FontSize="13" Padding="6,0" />
            </Border>
        </Grid>

        <TextBlock x:Name="RcStatus" Grid.Row="1" VerticalAlignment="Bottom" Margin="0,8,0,0"
                   FontSize="12.5" TextWrapping="Wrap" Foreground="#C42B1C" Visibility="Collapsed" />

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="RechargeButton" Grid.Column="0" Height="32" Content="充值" Appearance="Primary" FontSize="13"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Recharge_Click" />
            <ui:Button Grid.Column="2" Height="32" Content="取消" Appearance="Light" FontSize="13"
                       HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Click="Cancel_Click" />
        </Grid>
    </Grid>
</UserControl>
